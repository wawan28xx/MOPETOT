# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual env
.venv/
venv/
env/

# OS/editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local logs
*.log
web/server.log

# Runtime scan artifacts (sensitive / large)
web/uploads/
web/results/
reports/

# Local SQLite runtime DB
web/database/mobile_audit.db
web/database/*.db-wal
web/database/*.db-shm

# Local env files
.env
web/.env

# Optional local temp/test files
*.tmp
*.bak

# Local scratch/frida scripts (user-local, jangan di-push)
tmp/
llm_settings.json

# blutter: artefak auto-rebuild (SDK dart di-fetch otomatis per versi)
bin/blutter_src/dartsdk/
bin/blutter_src/build/
bin/blutter_src/bin/

# Runtime SDK berat (lokal saja — >100MB, tidak layak push GitHub)
bin/dotnet-sdk/
bin/ghidra*/
bin/vcpkg/

# SQLite DB runtime di root web/ (data klien — jangan push)
web/*.db
web/*.db-journal
web/*.db-wal
web/*.db-shm
